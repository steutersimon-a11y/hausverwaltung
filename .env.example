# Local development only. pnpm run setup creates .env with random local secrets.
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_TELEMETRY_DISABLED=1
DEMO_MODE=true
# Only permits HTTP on loopback for isolated local production-build tests.
ATLAS_ALLOW_LOCAL_HTTP=true
DATABASE_URL=postgres://atlas:atlas_local_only@127.0.0.1:5432/atlas
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_local_only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=atlas_local
S3_SECRET_ACCESS_KEY=atlas_s3_local_only
S3_BUCKET=atlas-private-documents
# No external map/geocoding/banking/API calls are enabled by default.
